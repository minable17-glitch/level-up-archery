# 이 파일을 .env로 복사하고 실제 값을 채워주세요. (.env는 git에 올라가지 않습니다)

# Supabase 대시보드 → Settings → Data API 에서 확인 (Project URL)
SUPABASE_URL=https://uufwydjebpxydyjjseix.supabase.co

# Supabase 대시보드 → Settings → API Keys 에서 "service_role" 키를 복사
# ⚠️ 이 키는 RLS(권한 체크)를 전부 건너뛰는 강력한 비밀키입니다.
#    절대 커밋하거나 공개하지 마세요. 이 .env 파일은 교사 본인 컴퓨터에만 둡니다.
SUPABASE_SERVICE_ROLE_KEY=
